{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ledgerflow-accounting",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "upload_source_maps": true,
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}